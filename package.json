{
  "name": "disco-bouncer",
  "author": "Tim Susa <timmsusa@googlemail.com>",
  "description": "disco-bouncer — Ableton Live-style matrix sequencer for sorting and playing audio clips",
  "version": "0.2.0-alpha.1",
  "main": "build/electron.js",
  "homepage": "./",
  "private": false,
  "license": "MIT",
  "repository": "https://github.com/TimSusa/disco-bouncer.git",
  "build": {
    "appId": "com.disco-bouncer.app",
    "asar": true,
    "files": [
      "build/**/*",
      "!node_modules/electron",
      "!node_modules/electron-reload",
      "!node_modules/.cache"
    ],
    "releaseInfo": {
      "releaseNotesFile": "./CHANGELOG.md"
    },
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "fileAssociations": [
        {
          "ext": [
            "mp3",
            "ogg",
            "flac",
            "mp4",
            "wav",
            "aif",
            "aiff",
            "m4a"
          ],
          "description": "Audio Files",
          "role": "Viewer"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio"
    }
  },
  "dependencies": {
    "@material-ui/core": "4.12.4",
    "@material-ui/icons": "4.11.3",
    "@material-ui/styles": "4.11.5",
    "@reduxjs/toolkit": "1.9.7",
    "electron-window-state": "5.0.3",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-redux": "7.2.9",
    "react-window": "1.8.10",
    "redux": "4.2.1",
    "typeface-roboto": "1.1.13",
    "uuid": "9.0.1",
    "wavesurfer.js": "6.6.4"
  },
  "devDependencies": {
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "electron": "33.3.1",
    "electron-builder": "26.0.12",
    "eslint-plugin-react": "7.37.3",
    "eslint-plugin-react-hooks": "4.6.2",
    "nodemon": "3.1.9",
    "react-app-rewired": "^2.2.1",
    "react-scripts": "4.0.3",
    "rimraf": "5.0.10",
    "wait-for-localhost": "4.1.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider REACT_APP_IS_WEB_MODE=false sh -c 'yarn clean:dist && concurrently \"BROWSER=none react-app-rewired start\" \"wait-for-localhost 3000 && electron .\"'",
    "build:ci": "cross-env NODE_OPTIONS=--openssl-legacy-provider REACT_APP_IS_WEB_MODE=false sh -c 'yarn clean:dist && react-app-rewired build && yarn cp-src-electron'",
    "build:app": "yarn build:ci && electron-builder --mac",
    "build:app:all": "yarn build:ci && electron-builder -mwl",
    "build:win": "yarn build:ci && electron-builder --win",
    "build:linux": "yarn build:ci && electron-builder --linux",
    "cp-src-electron": "cp -r ./src/app/electron.js ./src/app/preload.js ./src/app/config.js ./src/app/filewalker.js ./src/app/filewalker-tree.js build/",
    "build": "cross-env REACT_APP_IS_WEB_MODE=true react-app-rewired build",
    "lint": "eslint src/ --ext .js,.jsx",
    "clean": "yarn clean:dist",
    "clean:dist": "rimraf dist && rimraf build && mkdir build",
    "postinstall": "electron-builder install-app-deps"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
